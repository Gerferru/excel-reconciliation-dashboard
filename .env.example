# Configuración del Servidor SMTP para Alertas de Discrepancias
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_usuario@ejemplo.com
SMTP_PASSWORD=tu_contraseña_o_app_password
SMTP_USE_TLS=True

# Configuración del Correo
EMAIL_FROM=alertas-auditoria@ejemplo.com
EMAIL_TO=responsable1@ejemplo.com,responsable2@ejemplo.com
EMAIL_SUBJECT_PREFIX=[AUDITORÍA EXCEL]
